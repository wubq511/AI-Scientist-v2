#!/usr/bin/env python3
"""Guard and launch one frozen Prompt Profile comparison slot."""

from __future__ import annotations

import argparse
from decimal import Decimal, InvalidOperation
import os
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT))

from ai_scientist.ideation.canonical import canonical_json_bytes  # noqa: E402
from ai_scientist.ideation.comparison import (  # noqa: E402
    prepare_comparison_slot_launch,
    reserve_comparison_slot,
)
from ai_scientist.ideation.errors import IdeationInputError  # noqa: E402


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Reserve aggregate Canary budget and launch one frozen prompt-comparison slot."
        )
    )
    parser.add_argument("--package-dir", required=True, type=Path)
    parser.add_argument("--matrix-sha256", required=True)
    parser.add_argument("--reapproval-threshold-cny", required=True)
    parser.add_argument("--run-index", required=True, type=int)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)
    try:
        try:
            threshold = Decimal(args.reapproval_threshold_cny)
        except InvalidOperation:
            raise IdeationInputError(
                "INVALID_REAPPROVAL_THRESHOLD",
                "The frozen reapproval threshold must be a decimal CNY amount",
            )
        launch = prepare_comparison_slot_launch(
            REPO_ROOT,
            package_dir=args.package_dir,
            expected_matrix_sha256=args.matrix_sha256,
            expected_reapproval_threshold_cny=threshold,
            run_index=args.run_index,
        )
        reservation = reserve_comparison_slot(launch)
    except IdeationInputError as exc:
        sys.stderr.buffer.write(
            canonical_json_bytes(
                {
                    "code": exc.code,
                    "message": exc.message,
                    "status": "comparison_preflight_rejected",
                }
            )
        )
        return 2

    sys.stderr.buffer.write(
        canonical_json_bytes(
            {
                **launch["authorization"],
                "reservation_sha256": reservation["sha256"],
                "status": "comparison_slot_preflight_passed",
            }
        )
    )
    command = list(launch["command_argv"])
    try:
        os.execvpe(command[0], command, os.environ.copy())
    except OSError as exc:
        detail = exc.strerror or "unknown operating-system error"
        sys.stderr.buffer.write(
            canonical_json_bytes(
                {
                    "code": "COMPARISON_EXEC_FAILED",
                    "message": f"Could not execute production new-run: {detail}",
                    "status": "comparison_preflight_rejected",
                }
            )
        )
        return 126


if __name__ == "__main__":
    raise SystemExit(main())
